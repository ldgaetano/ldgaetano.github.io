---
import { EMAIL, GITHUB_URL, SITE_TITLE, withBase } from '../site';

const year = new Date().getFullYear();
---

<footer>
  <div class="container inner">
    <span>© {year} {SITE_TITLE}</span>
    <span class="links">
      <a href={withBase('rss.xml')}>RSS</a>
      <a href={GITHUB_URL}>GitHub</a>
      <a href={`mailto:${EMAIL}`}>Email</a>
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 1.4rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .links {
    display: flex;
    gap: 1rem;
  }

  a {
    color: var(--muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }
</style>
