---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={withBase('rss.xml')} />
  </head>
  <body>
    <Header />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fcfcfa;
    --card: #ffffff;
    --fg: #22272e;
    --muted: #66707b;
    --border: #e3e3de;
    --accent: #0f6e62;
    --accent-ink: #ffffff;
    --serif: Georgia, 'Times New Roman', Times, serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141619;
      --card: #1b1e22;
      --fg: #d9dde3;
      --muted: #909aa4;
      --border: #2a2e33;
      --accent: #53b3a6;
      --accent-ink: #0e1512;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg);
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  main {
    flex: 1;
    width: 100%;
  }

  .container {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  main .container {
    padding-block: 2.75rem 3.5rem;
  }

  h1,
  h2,
  h3 {
    font-family: var(--serif);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  h1 {
    font-size: 2.1rem;
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: 1.35rem;
    margin: 2.5rem 0 0.75rem;
  }

  h3 {
    font-size: 1.1rem;
  }

  a {
    color: var(--accent);
  }

  .lede {
    color: var(--muted);
    margin-top: -0.25rem;
  }

  .button {
    display: inline-block;
    padding: 0.45rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 8px;
    text-decoration: none;
    color: var(--accent);
    font-size: 0.95rem;
  }

  .button:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .button.ghost {
    border-color: var(--border);
    color: var(--muted);
  }

  .button.ghost:hover {
    border-color: var(--accent);
    background: transparent;
    color: var(--accent);
  }

  /* Blog-style lists (used on the home page and blog index) */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-list li:first-child {
    border-top: 1px solid var(--border);
  }

  .post-list a {
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
  }

  .post-list a:hover {
    color: var(--accent);
  }

  .post-list time {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }

  .post-list p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* Publication cards */
  .papers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }

  .paper {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
  }

  .paper .title {
    margin: 0;
    font-weight: 600;
  }

  .paper .meta {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .paper .links {
    margin: 0.5rem 0 0;
    display: flex;
    gap: 0.9rem;
    font-size: 0.9rem;
  }

  /* Markdown content */
  .prose {
    line-height: 1.7;
  }

  .prose p {
    margin: 1rem 0;
  }

  .prose h2 {
    margin-top: 2.2rem;
  }

  .prose h3 {
    margin-top: 1.8rem;
  }

  .prose code {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.88em;
  }

  .prose pre {
    padding: 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--card);
    overflow-x: auto;
  }

  .prose pre code {
    background: none;
    padding: 0;
  }

  .prose blockquote {
    border-left: 3px solid var(--accent);
    margin: 1.2rem 0;
    padding: 0.1rem 1.2rem;
    color: var(--muted);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4rem;
  }

  .prose img {
    max-width: 100%;
    border-radius: 8px;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
</style>
